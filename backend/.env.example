# ========================================================
# Configuração do Banco de Dados Supabase (Schema jm_motos)
# ========================================================
# Host: aws-1-sa-east-1.pooler.supabase.com
# Porta recomendada para Java/Spring Boot + Flyway: 5432 (Session Mode)
# Porta alternativa: 6543 (Transaction Mode)

# Opção 1: Supabase PostgreSQL (Nuvem - Session Mode porta 5432)
DATABASE_URL=jdbc:postgresql://aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require&currentSchema=jm_motos
DATABASE_USER={SEU USER}
DATABASE_PASSWORD=[SUA-SENHA-DO-SUPABASE]
DATABASE_DRIVER=org.postgresql.Driver
DB_SCHEMA=jm_motos

# Opção 2: PostgreSQL Local (Docker Compose)
# DATABASE_URL=jdbc:postgresql://localhost:5432/jm_motos?currentSchema=jm_motos
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgrespassword
# DATABASE_DRIVER=org.postgresql.Driver
# DB_SCHEMA=jm_motos

# Porta do Servidor e Perfil Ativo
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Chave JWT (Segurança)
JWT_SECRET=sua-criptografia
JWT_EXPIRATION_MS=86400000

# CORS (Frontend Angular)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80,http://localhost
